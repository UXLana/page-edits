{
  "name": "page-edits",
  "version": "0.1.0",
  "description": "Highlight copy on your running Vite site, type what should change and keep going, while a Claude Code session rewrites it in the source.",
  "keywords": ["vite-plugin", "copywriting", "copy-editing", "content", "claude-code"],
  "homepage": "https://github.com/UXLana/page-edits#readme",
  "bugs": "https://github.com/UXLana/page-edits/issues",
  "repository": { "type": "git", "url": "git+https://github.com/UXLana/page-edits.git" },
  "license": "MIT",
  "author": "Lana Holston",
  "type": "module",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./vite-plugin.mjs" },
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "bin": { "page-edits": "cli.mjs" },
  "files": [
    "cli.mjs",
    "client.js",
    "finder.mjs",
    "fold.mjs",
    "fold.d.mts",
    "index.d.ts",
    "receiver.mjs",
    "store.mjs",
    "vite-plugin.mjs"
  ],
  "scripts": {
    "test": "node test/fixture-test.mjs",
    "test:browser": "node test/e2e.mjs",
    "test:plugin": "claude plugin test ."
  },
  "engines": { "node": ">=18" },
  "peerDependencies": { "vite": ">=4" }
}
